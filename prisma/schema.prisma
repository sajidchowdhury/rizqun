// Rizqun — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────

enum UserRole {
  super_admin
  user
}

enum VendorCategory {
  grocery
  medicine
  other
}

enum OrderStatus {
  pending
  waiting_vendor
  preparing
  picked_up
  delivered
  cancelled
}

// ─── Hierarchy: Section → Group → Category → SubCategory → Product
// Example: Grocery → Cooking → Spices → Whole Spices → Golden Grain Cumin

// ─── Section (top level: Grocery, Medicine, Other) ───────────

model Section {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  groups Group[]

  @@map("sections")
}

// ─── Group (belongs to Section — from Index "Category" column) ─
// Example: Cooking, Beverages, Dairy

model Group {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  sectionId Int       @map("section_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  section    Section    @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  categories Category[]

  @@index([sectionId])
  @@map("groups")
}

// ─── Category (belongs to Group — from Excel sheet name) ───────
// Example: Spices, Rice, Oil, Tea

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  groupId   Int       @map("group_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  group         Group        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  subCategories SubCategory[]
  products      Product[]

  @@index([groupId])
  @@map("categories")
}

// ─── SubCategory (belongs to Category — from Index "Subcategory" column)
// Example: Whole Spices, Ground Spices (under Spices category)

model SubCategory {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String
  categoryId  Int       @map("category_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category  Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products  Product[]

  @@index([categoryId])
  @@map("sub_categories")
}

// ─── User ──────────────────────────────────────────────────────

model User {
  id             Int       @id @default(autoincrement())
  name           String
  email          String    @unique
  phone          String
  passwordHash   String    @map("password_hash")
  role           UserRole  @default(user)
  categoryAccess Json      @default("[]") @map("category_access")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([role])
  @@map("users")

  orders    Order[]
  statusLogs StatusLog[]
}

// ─── Vendor (physical shop/supplier, NOT a product brand) ─────

model Vendor {
  id             Int            @id @default(autoincrement())
  name           String
  phone          String
  whatsappNumber String?       @map("whatsapp_number")
  category       VendorCategory @default(other)
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  products       Product[]
  productVendors ProductVendor[]
  orderItems     OrderItem[]

  @@index([category])
  @@index([isActive])
  @@map("vendors")
}

// ─── Product ──────────────────────────────────────────────────

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  sku           String?  @unique
  brand         String?
  price         Decimal  @db.Decimal(10, 2)
  categoryId    Int      @map("category_id")
  vendorId      Int?     @map("vendor_id")
  subCategoryId Int?     @map("sub_category_id")
  unit          String   @default("pcs")
  searchVector  Unsupported("tsvector")? @map("search_vector")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  imageUrl       String?  @map("image_url")
  originalPrice  Decimal? @db.Decimal(10, 2) @map("original_price")
  discountActive Boolean  @default(false) @map("discount_active")
  genericName    String?  @map("generic_name")
  isEssential    Boolean  @default(false) @map("is_essential")

  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendor         Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  subCategory    SubCategory?  @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  productVendors ProductVendor[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([vendorId])
  @@index([subCategoryId])
  @@index([isActive])
  @@index([isEssential])
  @@map("products")
}

// ─── ProductVendor (many-to-many junction) ────────────────────

model ProductVendor {
  id        Int @id @default(autoincrement())
  productId Int @map("product_id")
  vendorId  Int @map("vendor_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([productId, vendorId])
  @@index([vendorId])
  @@map("product_vendors")
}

// ─── Orders ─────────────────────────────────────────────────────

model Order {
  id              Int         @id @default(autoincrement())
  orderCode       String      @unique @map("order_code")
  userId          Int         @map("user_id")
  customerName    String      @map("customer_name")
  customerPhone   String      @map("customer_phone")
  customerAddress String?     @map("customer_address")
  subtotal        Decimal     @db.Decimal(12, 2)
  deliveryFee     Decimal     @default(0) @db.Decimal(10, 2) @map("delivery_fee")
  total           Decimal     @db.Decimal(12, 2)
  status          OrderStatus @default(pending)
  ratingToken     String?     @unique @map("rating_token")
  createdAt       DateTime    @default(now()) @map("created_at")
  deliveredAt     DateTime?   @map("delivered_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  statusLogs StatusLog[]
  rating     Rating?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([deliveredAt])
  @@map("orders")
}

model OrderItem {
  id                   Int      @id @default(autoincrement())
  orderId              Int      @map("order_id")
  productId            Int?     @map("product_id")
  vendorId             Int      @map("vendor_id")
  productNameSnapshot  String   @map("product_name_snapshot")
  priceSnapshot        Decimal @db.Decimal(10, 2) @map("price_snapshot")
  qty                  Int      @default(1)
  lineTotal            Decimal @db.Decimal(12, 2) @map("line_total")
  addedAfterFinalize   Boolean  @default(false) @map("added_after_finalize")
  addedAt              DateTime @default(now()) @map("added_at")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([vendorId])
  @@index([addedAfterFinalize])
  @@map("order_items")
}

model StatusLog {
  id         Int          @id @default(autoincrement())
  orderId    Int          @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  changedBy  Int          @map("changed_by")
  note       String?
  changedAt  DateTime     @default(now()) @map("changed_at")

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changer User  @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([changedBy])
  @@index([toStatus])
  @@map("status_log")
}

model Rating {
  id          Int      @id @default(autoincrement())
  orderId     Int      @unique @map("order_id")
  overall     Int
  speed       Int
  behavior    Int
  comment     String?  @db.Text
  submittedAt DateTime @default(now()) @map("submitted_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("ratings")
}
